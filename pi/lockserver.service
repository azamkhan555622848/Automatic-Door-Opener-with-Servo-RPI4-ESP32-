[Unit]
Description=Door-lock person detector and TCP link
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=asus
WorkingDirectory=/home/asus/pi
ExecStart=/usr/bin/python3 /home/asus/pi/detector.py --camera 0 --port 5000 --hold 5
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
